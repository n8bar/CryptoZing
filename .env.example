APP_NAME=CryptoZing
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PUBLIC_URL=${APP_URL}

# Invite-gate for new registrations. Leave off for a self-hosted instance —
# with it on, new accounts wait for approval from a SUPPORT_AGENT_EMAILS account.
ALPHA_GATE_ENABLED=false
# Proxy IPs/CIDRs (comma-separated) whose X-Forwarded-* headers are trusted; '*' trusts the directly connecting client (dev only)
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
SAIL_PHP_EXTENSIONS="bcmath,pcntl,pdo_mysql,redis,gmp"

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=
MYSQL_EXTRA_OPTIONS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Where the queue and scheduler workers leave the heartbeat their container
# healthcheck reads. Defaults to the system temp dir.
# WORKER_HEARTBEAT_DIR=/tmp

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

#MAIL_MAILER=log
#MAIL_FROM_ADDRESS="hello@example.com"
#MAIL_FROM_NAME="${APP_NAME}"

MAIL_MAILER=mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_OUTBOUND_ENABLED=false
MAIL_MANUAL_SEND_COOLDOWN_MINUTES=60
MAIL_ALERT_COOLDOWN_MINUTES=1440
# Test-only recipient rewrite — never enable with real customers.
MAIL_ALIAS_ENABLED=false
MAIL_ALIAS_DOMAIN=
SUPPORT_AGENT_EMAILS=
SUPPORT_ACCESS_HOURS=72
SUPPORT_ACCESS_TERMS_VERSION=v1

# Blank = no /donate page and no donation addresses (safe default).
# A bare key derives BIP84; wrap a Taproot key as tr(xpub.../0/*).
DONATION_WALLET_XPUB=
DONATION_NOTIFY_EMAIL=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
FORWARD_DB_PORT=3307
