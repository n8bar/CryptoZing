# CryptoZing's blocks in the shared front door (OUR deployment only).
# deploy.sh fills in ${CZ_PUBLIC_SERVER_NAME}, writes the result to
# frontdoor/cryptozing.conf in the compose folder, and asks the front door's
# guard to load it. The front door ends TLS and hands each request to cz-nginx
# over the frontdoor network; cz-nginx does the routing.

# Port 80: ACME webroot for the names we hold, then canonical redirects.
server {
    listen 80;
    server_name ${CZ_PUBLIC_SERVER_NAME} stats.${CZ_PUBLIC_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80;
    server_name www.${CZ_PUBLIC_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${CZ_PUBLIC_SERVER_NAME}$request_uri;
    }
}

# The apex and stats hostnames, passed through to cz-nginx.
server {
    listen 443 ssl;
    http2 on;
    server_name ${CZ_PUBLIC_SERVER_NAME} stats.${CZ_PUBLIC_SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${CZ_PUBLIC_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CZ_PUBLIC_SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Docker's embedded DNS; the variable upstream resolves per request, so a
    # replaced or stopped cz-nginx never stops the front door from loading.
    resolver 127.0.0.11 valid=10s;
    set $cryptozing_upstream http://cz-nginx:80;

    client_max_body_size 12m;

    location / {
        proxy_pass $cryptozing_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# www → apex, over TLS (the apex certificate carries the www SAN).
server {
    listen 443 ssl;
    http2 on;
    server_name www.${CZ_PUBLIC_SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${CZ_PUBLIC_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CZ_PUBLIC_SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://${CZ_PUBLIC_SERVER_NAME}$request_uri;
}
