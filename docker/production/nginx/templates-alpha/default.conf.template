# Front nginx for OUR alpha deployment only (M20.2 §3.3/§3.4) — the published
# recipe uses templates/default.conf.template instead. Differences:
#   - proxies /learn/ to the article-site container
#   - noindex headers + deny-all robots.txt on the private hostname
# Canonicals inside the proxied articles already point at cryptozing.app,
# so this copy never competes with the live site.

server {
    listen 80;
    server_name ${CZ_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CZ_SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${CZ_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CZ_SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Docker's embedded DNS; variable upstreams below force per-request
    # resolution so container replacement never leaves nginx on a dead IP.
    resolver 127.0.0.11 valid=10s;

    root /var/www/html/public;
    index index.php;
    client_max_body_size 12m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Private window: keep this hostname out of the index (§3.4).
    add_header X-Robots-Tag "noindex, nofollow" always;

    location = /robots.txt {
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Article site, proxied from the site container (§3.3).
    location /learn/ {
        set $site_upstream http://site:80;
        proxy_pass $site_upstream;
        proxy_set_header Host $host;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        set $app_upstream app:9000;
        fastcgi_pass $app_upstream;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
    }

    location ~* \.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
