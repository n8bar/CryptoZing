# Front nginx for OUR deployment behind the shared front door — selected with
# CZ_NGINX_TEMPLATES=templates-frontdoor. The front door (its own stack, not
# this repo's) holds ports 80/443 and TLS, then passes the apex and stats
# hostnames here over the frontdoor network. Its blocks for those names come
# from docker/production/frontdoor/, which deploy.sh renders and loads.
# Same routing as templates-apex, minus TLS and the canonical redirects.

server {
    listen 80;
    server_name ${CZ_PUBLIC_SERVER_NAME};

    # Only the front door reaches this port. Take the client address it
    # forwards, so the app and Umami see visitors, not the front door.
    set_real_ip_from 172.30.0.0/24;
    real_ip_header X-Real-IP;
    # Redirects stay relative; the front door owns scheme and host.
    absolute_redirect off;

    # Docker's embedded DNS; variable upstreams below force per-request
    # resolution so container replacement never leaves nginx on a dead IP.
    resolver 127.0.0.11 valid=10s;

    root /var/www/html/public;
    index index.php;
    client_max_body_size 12m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # No X-Robots-Tag: the apex is indexable. Invoice views set their own
    # noindex header in the app; staging drafts carry an in-page noindex meta.

    set $site_upstream http://site:80;

    # Slashless entry points behave as Pages did: one hop to the directory.
    location = /learn   { return 301 /learn/; }
    location = /staging { return 301 /staging/; }

    # Published guides and their review copies. ^~ keeps the static-file regex
    # below from capturing article assets. Slashless article URLs get the site
    # container's relative 301 (absolute_redirect off there).
    location ^~ /learn/ {
        proxy_pass $site_upstream;
        proxy_set_header Host $host;
    }
    location ^~ /staging/ {
        proxy_pass $site_upstream;
        proxy_set_header Host $host;
    }

    # Content-owned root files: robots (with the Sitemap line), the sitemap,
    # and the IndexNow key file all come from the site build, never the app.
    location = /robots.txt {
        proxy_pass $site_upstream;
        proxy_set_header Host $host;
    }
    location = /sitemap.xml {
        proxy_pass $site_upstream;
        proxy_set_header Host $host;
    }
    location ~ "^/[0-9a-f]{32}\.txt$" {
        proxy_pass $site_upstream;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        set $app_upstream app:9000;
        fastcgi_pass $app_upstream;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_param SERVER_PORT 443;
    }

    location ~* \.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}

# Self-hosted analytics (M21.1 §2.2) on its own hostname.
server {
    listen 80;
    server_name stats.${CZ_PUBLIC_SERVER_NAME};

    # Only the front door reaches this port. Take the client address it
    # forwards, so the app and Umami see visitors, not the front door.
    set_real_ip_from 172.30.0.0/24;
    real_ip_header X-Real-IP;
    # Redirects stay relative; the front door owns scheme and host.
    absolute_redirect off;

    resolver 127.0.0.11 valid=10s;
    client_max_body_size 1m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location = /robots.txt {
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location / {
        set $umami_upstream http://umami:3000;
        proxy_pass $umami_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}
